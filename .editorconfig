root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,config,json,yml,yaml}]
indent_size = 2

[*.cs]
# File-scoped namespaces and modern C# conventions.
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# ADR-035: treat all .NET code-style analyzer warnings as build errors.
dotnet_analyzer_diagnostic.category-Style.severity = error
dotnet_analyzer_diagnostic.category-Design.severity = error
dotnet_analyzer_diagnostic.category-Usage.severity = error
dotnet_analyzer_diagnostic.category-Naming.severity = error

# Taste-based rules that are layout/preference only — CSharpier owns layout, and
# block-vs-expression body / primary-constructor are not correctness concerns.
# Kept non-blocking deliberately (the ".editorconfig evaluation" ADR-035 calls for).
dotnet_diagnostic.IDE0021.severity = silent   # use block body for constructor
dotnet_diagnostic.IDE0022.severity = silent   # use block body for method
dotnet_diagnostic.IDE0023.severity = silent   # use block body for conversion operator
dotnet_diagnostic.IDE0024.severity = silent   # use block body for operator
dotnet_diagnostic.IDE0025.severity = silent   # use expression body for property
dotnet_diagnostic.IDE0027.severity = silent   # use expression body for accessor
dotnet_diagnostic.IDE0290.severity = silent   # use primary constructor

# `var` vs explicit type is a team style choice, not a correctness concern — allow both.
dotnet_diagnostic.IDE0007.severity = silent   # use var
dotnet_diagnostic.IDE0008.severity = silent   # use explicit type

[tests/**/*.cs]
# Test projects follow the Phoenix unit-test naming convention
# ({Method}_When{Condition}_Then{Result}), which CA1707 forbids — relax it here only.
dotnet_diagnostic.CA1707.severity = none
# Fluent assertions (AwesomeAssertions) intentionally discard their chained return value.
dotnet_diagnostic.IDE0058.severity = none
# Test classes are public xUnit fixtures by design.
dotnet_diagnostic.CA1515.severity = none

[src/CheckoutKata.{Api,AppHost,ServiceDefaults}/**.cs]
# Aspire / minimal-API scaffolding follows framework idioms that differ from the kata's
# hand-written core. These relaxations apply ONLY to the host/infra projects; the strict
# bar (and TreatWarningsAsErrors, incl. the NU1902 security audit) still holds everywhere else.
# Fluent builder/endpoint chains intentionally discard their return value.
dotnet_diagnostic.IDE0058.severity = none
# ServiceDefaults lives in the Microsoft.Extensions.Hosting namespace by Aspire convention
# (so AddServiceDefaults() is discoverable); this deliberately won't match the folder name.
dotnet_diagnostic.IDE0130.severity = none
