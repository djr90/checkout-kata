<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore exclusively from the public NuGet gallery. No internal/Artifactory feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
